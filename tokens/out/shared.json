{
  "radius": {
    "xs": 3,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "border": {
    "hairline": 1,
    "frame": 2,
    "focus": 1
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "gutter": 16,
    "margin": 24
  },
  "sizes": {
    "bar_height": 36,
    "titlebar_height": 28,
    "seal_small": 14,
    "seal_medium": 24,
    "seal_large": 48,
    "control_height": 32,
    "control_height_large": 48,
    "hairline_inset": 4,
    "card_padding": 16,
    "icon": 16,
    "icon_large": 24
  },
  "type": {
    "families": {
      "display_cjk": "Ma Shan Zheng",
      "title": "ZCOOL XiaoWei",
      "body_cjk": "LXGW WenKai",
      "jp_flavour": "Shippori Mincho B1",
      "jp_brush": "Yuji Syuku",
      "serif_latin_display": "Cormorant Garamond",
      "serif_latin_body": "EB Garamond",
      "ui": "Noto Sans",
      "mono": "JetBrainsMono Nerd Font",
      "mono_propo": "JetBrainsMono Nerd Font Propo"
    },
    "roles": {
      "display": {
        "family": "Ma Shan Zheng",
        "size": 32,
        "weight": 400,
        "line_height": 1.15,
        "use": "card titles in CJK, hyprlock 時辰, seals at 48+"
      },
      "display_sm": {
        "family": "Ma Shan Zheng",
        "size": 28,
        "weight": 400,
        "line_height": 1.15,
        "use": "section heads, cabinet column labels"
      },
      "title": {
        "family": "ZCOOL XiaoWei",
        "size": 18,
        "weight": 400,
        "line_height": 1.2,
        "use": "title bars (CJK + Latin), panel headers"
      },
      "subtitle": {
        "family": "Cormorant Garamond",
        "size": 13,
        "weight": 500,
        "line_height": 1.2,
        "letter_spacing": 0.08,
        "use": "Latin subtitle under / beside a CJK title, small caps"
      },
      "body": {
        "family": "LXGW WenKai",
        "size": 14,
        "weight": 400,
        "line_height": 1.45,
        "use": "widget body text, drawer labels, notification body"
      },
      "body_latin": {
        "family": "EB Garamond",
        "size": 15,
        "weight": 400,
        "line_height": 1.45,
        "use": "quotes, long Latin prose"
      },
      "ui": {
        "family": "Noto Sans",
        "size": 13,
        "weight": 400,
        "line_height": 1.4,
        "use": "buttons, form fields, lists, status"
      },
      "small": {
        "family": "Noto Sans",
        "size": 12,
        "weight": 400,
        "line_height": 1.3,
        "use": "captions, timestamps, bar chips"
      },
      "mono": {
        "family": "JetBrainsMono Nerd Font",
        "size": 13,
        "weight": 400,
        "line_height": 1.4,
        "use": "sysinfo, cava labels, icon glyphs"
      },
      "clock_bar": {
        "family": "Cormorant Garamond",
        "size": 16,
        "weight": 600,
        "line_height": 1.0,
        "use": "bar clock HH:MM"
      },
      "clock_lock": {
        "family": "Cormorant Garamond",
        "size": 128,
        "weight": 300,
        "line_height": 1.0,
        "use": "hyprlock clock"
      },
      "shichen_lock": {
        "family": "Ma Shan Zheng",
        "size": 96,
        "weight": 400,
        "line_height": 1.0,
        "use": "hyprlock 時辰 glyph, vermilion"
      },
      "quote_lock": {
        "family": "EB Garamond",
        "size": 20,
        "weight": 400,
        "line_height": 1.4,
        "italic": true,
        "use": "hyprlock quote"
      },
      "weather_temp": {
        "family": "Cormorant Garamond",
        "size": 56,
        "weight": 500,
        "line_height": 1.0,
        "use": "big temperature"
      }
    }
  },
  "motion": {
    "duration": {
      "fast": 160,
      "base": 350,
      "slow": 600,
      "theme_fade": 500,
      "wallpaper": 1200,
      "stagger": 40
    },
    "easing": {
      "ink": {
        "bezier": [
          0.22,
          1.0,
          0.36,
          1.0
        ],
        "hyprland": "ink, 0.22, 1, 0.36, 1",
        "qml": "Easing.OutQuint",
        "css": "cubic-bezier(.22,1,.36,1)",
        "use": "panels, windows, notifications entering"
      },
      "brush": {
        "bezier": [
          0.65,
          0.0,
          0.35,
          1.0
        ],
        "hyprland": "brush, 0.65, 0, 0.35, 1",
        "qml": "Easing.InOutCubic",
        "css": "cubic-bezier(.65,0,.35,1)",
        "use": "symmetric moves, toggles, cross-fades"
      },
      "drift": {
        "bezier": [
          0.33,
          1.0,
          0.68,
          1.0
        ],
        "hyprland": "drift, 0.33, 1, 0.68, 1",
        "qml": "Easing.OutCubic",
        "css": "cubic-bezier(.33,1,.68,1)",
        "use": "workspaces, hover washes, progress"
      }
    },
    "translate": {
      "panel": 12,
      "notification": 16,
      "osd": 8,
      "hover": 0
    },
    "hyprland": {
      "windowsIn": "7, ink, popin 85%",
      "windowsOut": "6, brush, popin 85%",
      "windowsMove": "6, drift",
      "fade": "5, brush",
      "fadeDim": "5, brush",
      "workspaces": "8, drift, slide",
      "layers": "5, ink, slide",
      "layersIn": "6, ink, slide",
      "layersOut": "5, brush, fade",
      "border_angle": "off"
    },
    "reduced_motion": "when ~/.config/apothecary/config.json has {\"reduced_motion\":true}: durations 0 except theme_fade 150; translate 0; wallpaper transition 'fade' 0.3"
  },
  "shadow": {
    "card": {
      "x": 0,
      "y": 4,
      "blur": 12,
      "spread": 0,
      "opacity": 0.22
    },
    "panel": {
      "x": 0,
      "y": 8,
      "blur": 24,
      "spread": 0,
      "opacity": 0.3
    },
    "note": {
      "x": 2,
      "y": 3,
      "blur": 6,
      "spread": 0,
      "opacity": 0.25
    },
    "hyprland": {
      "range": 18,
      "render_power": 3,
      "offset": "0 3",
      "scale": 0.97
    }
  },
  "blur": {
    "hyprland": {
      "enabled": true,
      "size": 6,
      "passes": 3,
      "vibrancy": 0.17,
      "noise": 0.02,
      "contrast": 0.9,
      "brightness": 0.95,
      "xray": false,
      "layers": [
        "bar",
        "launcher",
        "network",
        "power",
        "osd",
        "notifications"
      ]
    }
  },
  "opacity": {
    "card_transparent": 0.82,
    "texture_overlay": {
      "light": 0.5,
      "dark": 0.45
    },
    "ink_wash_hover": 0.08,
    "ink_wash_pressed": 0.16,
    "disabled": 0.45,
    "dim_inactive": 0.05,
    "scrim": 0.35,
    "bar": 0.92,
    "drawer_hover_lift": 1.0,
    "texture_overlay_note": "applies to the tinted tiles (mean = surface tone), so it only scales grain strength; for the neutral *-grain.png tiles use 0.15–0.30 with Multiply/Overlay"
  },
  "textures": {
    "paper": "assets/pd/textures/paper.png",
    "paper_tile": "assets/pd/textures/paper-tile.png",
    "lacquer": "assets/pd/textures/lacquer.png",
    "lacquer_tile": "assets/pd/textures/lacquer-tile.png",
    "ink_edge_mask": "assets/pd/textures/ink-edge-mask.png",
    "ink_divider": "assets/pd/textures/ink-divider.png",
    "enso": "assets/pd/textures/enso.png",
    "seal_yaku": "assets/pd/seals/seal-薬.png",
    "seal_neko": "assets/pd/seals/seal-猫.png",
    "seal_in": "assets/pd/seals/seal-印.png"
  }
}
