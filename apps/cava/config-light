# Apothecary Hyprland — cava (light). Linked as ~/.config/cava/config via ~/.config/apothecary/cava/current.
# [color] values = tokens/out/light/cava.conf. The user's original is kept at ~/.config/cava/config.pre-apothecary.
[general]
framerate = 60
bars = 32
bar_width = 2
bar_spacing = 1
autosens = 1
sensitivity = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 0

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average
reverse = 0

[color]
background = '#f3ecdc'
foreground = '#2a2622'
gradient = 1
gradient_count = 8
gradient_color_1 = '#376a4e'
gradient_color_2 = '#4d6542'
gradient_color_3 = '#636137'
gradient_color_4 = '#7a5c2b'
gradient_color_5 = '#8c4d2b'
gradient_color_6 = '#9e3e2a'
gradient_color_7 = '#b02f2a'
gradient_color_8 = '#b02f2a'

[smoothing]
noise_reduction = 77
monstercat = 1
waves = 0

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
