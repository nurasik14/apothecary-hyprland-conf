# Apothecary Hyprland — cava (dark). Linked as ~/.config/cava/config via ~/.config/apothecary/cava/current.
# [color] values = tokens/out/dark/cava.conf. The user's original is kept at ~/.config/cava/config.pre-apothecary.
[general]
framerate = 60
bars = 32
bar_width = 2
bar_spacing = 1
autosens = 1
sensitivity = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 0

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average
reverse = 0

[color]
background = '#1e1915'
foreground = '#eadfc7'
gradient = 1
gradient_count = 8
gradient_color_1 = '#7fc19a'
gradient_color_2 = '#97b786'
gradient_color_3 = '#b0ad72'
gradient_color_4 = '#c9a35e'
gradient_color_5 = '#c9824e'
gradient_color_6 = '#c8623f'
gradient_color_7 = '#c8402f'
gradient_color_8 = '#c8402f'

[smoothing]
noise_reduction = 77
monstercat = 1
waves = 0

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
