/* Apothecary Hyprland — rofi theme (both modes).
 * Loaded last from ~/.config/rofi/config.rasi via
 *   @theme "~/.config/apothecary/rofi/current.rasi"
 * Colours: ~/.config/apothecary/rofi/colors.rasi → tokens/out/<mode>/rofi-colors.rasi (flipped by apps/apply-mode.sh).
 * Shape: a mounted paper card — lacquer title strip with a centred title and a red seal on the right,
 * drawer-like rows, the selected row stamped with the seal. Width 720.
 * JaKooLit's menus (emoji, clipboard, keybinds, wallpaper…) @import config.rasi and override widgets after this.
 */

@import "~/.config/apothecary/rofi/colors.rasi"

configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "药 Apps";
    display-run:                "令 Run";
    display-filebrowser:        "庫 Files";
    display-window:             "窓 Windows";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    font:                       "Noto Sans 12";
}

* {
    background-color:           transparent;
    text-color:                 @text;
    spacing:                    0px;
    margin:                     0px;
    padding:                    0px;
}

window {
    location:                   center;
    anchor:                     center;
    width:                      720px;
    border:                     2px;
    border-radius:              8px;
    border-color:               @frame;
    background-color:           @bg1;
    cursor:                     "default";
}

mainbox {
    orientation:                vertical;
    children:                   [ "titlebar", "inputbar", "message", "listview", "mode-switcher" ];
    background-color:           @bg1;
    border-radius:              6px;
}

/* lacquer title strip: 药櫃 · APOTHECARY ........ [印] */
titlebar {
    expand:                     false;
    orientation:                horizontal;
    children:                   [ "textbox-title", "textbox-seal" ];
    background-color:           @titlebar;
    padding:                    6px 12px 6px 36px;
    spacing:                    8px;
    border-radius:              6px 6px 0px 0px;
}
textbox-title {
    content:                    "药櫃 · APOTHECARY";
    font:                       "ZCOOL XiaoWei 15";
    text-color:                 @titlebarText;
    horizontal-align:           0.5;
    vertical-align:             0.5;
    expand:                     true;
    background-color:           transparent;
}
textbox-seal {
    content:                    "印";
    font:                       "Ma Shan Zheng 11";
    text-color:                 @textOnSeal;
    background-color:           @seal;
    border-radius:              3px;
    padding:                    1px 5px;
    expand:                     false;
    vertical-align:             0.5;
}

/* search drawer */
inputbar {
    expand:                     false;
    children:                   [ "prompt", "entry" ];
    background-color:           @surface;
    border:                     0px 0px 1px 0px;
    border-color:               @hairline;
    padding:                    12px 16px;
    spacing:                    10px;
}
prompt {
    text-color:                 @accent;
    font:                       "LXGW WenKai 13";
    vertical-align:             0.5;
    background-color:           transparent;
}
entry {
    placeholder:                "找 · search…";
    placeholder-color:          @textMuted;
    cursor:                     text;
    cursor-color:               @cursor;
    vertical-align:             0.5;
    background-color:           transparent;
}
message {
    background-color:           @surfaceAlt;
    padding:                    8px 16px;
    border:                     0px 0px 1px 0px;
    border-color:               @hairline;
}
textbox {
    text-color:                 @textMuted;
    background-color:           transparent;
}

/* drawers */
listview {
    columns:                    2;
    lines:                      8;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  true;
    spacing:                    6px;
    padding:                    12px 12px 12px 16px;
    fixed-height:               true;
    background-color:           @bg1;
}
scrollbar {
    handle-width:               4px;
    handle-color:               @hairline;
    background-color:           transparent;
    margin:                     0px 0px 0px 6px;
}
element {
    orientation:                horizontal;
    spacing:                    10px;
    padding:                    8px 10px;
    border-radius:              6px;
    border:                     1px;
    border-color:               @hairline;
    background-color:           @surface;
    cursor:                     pointer;
}
element normal.normal, element alternate.normal { background-color: @surface;    text-color: @text; }
element normal.urgent, element alternate.urgent { background-color: @sealWash;   text-color: @error; border-color: @seal; }
element normal.active, element alternate.active { background-color: @surfaceAlt; text-color: @accent; }
element selected.normal {
    background-color:           @surfaceAlt;
    text-color:                 @text;
    border:                     1px 1px 1px 3px;
    border-color:               @seal;
}
element selected.urgent { background-color: @seal;   text-color: @textOnSeal;   border-color: @seal; }
element selected.active { background-color: @accent; text-color: @textOnAccent; border-color: @accent; }
element-icon {
    size:                       24px;
    vertical-align:             0.5;
    background-color:           transparent;
}
element-text {
    vertical-align:             0.5;
    highlight:                  bold;
    text-color:                 inherit;
    background-color:           transparent;
}

/* bottom: mode tabs as paper labels */
mode-switcher {
    expand:                     false;
    spacing:                    8px;
    padding:                    8px 16px 12px 16px;
    background-color:           @bg0;
    border:                     1px 0px 0px 0px;
    border-color:               @hairline;
    border-radius:              0px 0px 6px 6px;
}
button {
    padding:                    6px 10px;
    border-radius:              6px;
    background-color:           @surface;
    text-color:                 @textMuted;
    font:                       "LXGW WenKai 12";
    border:                     1px;
    border-color:               @hairline;
    cursor:                     pointer;
}
button selected {
    background-color:           @titlebar;
    text-color:                 @titlebarText;
    border-color:               @titlebar;
}

/* error */
error-message {
    padding:                    16px;
    background-color:           @bg1;
    border:                     2px;
    border-color:               @seal;
    border-radius:              8px;
}
