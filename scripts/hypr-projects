#!/usr/bin/env bash
# hypr-projects — the Projects to-do list shared by every theme (Overworld, Apothecary) and the stock desktop.
#
#   hypr-projects [list] [--json]                       numbered list: in progress, then built (newest first)
#   hypr-projects add <title…> [--note N] [--built]
#   hypr-projects done|undone|toggle|rm <n|title>       <n> = the number from `list`, else the start of a title
#   hypr-projects rename <n|title> <new title…>
#   hypr-projects clear [--yes]                         remove every built project
#   hypr-projects menu [--if-stock]                     rofi picker (Enter toggles, + Add, ✕ Remove); --if-stock = only when no theme is on
#   hypr-projects summary [--print]                     notify-send "3 in progress · 2 built"
#   hypr-projects path | help
#   hypr-projects raw <op> …                            what the QML services call (see `help raw`)
#
# Data: ~/.local/share/hypr-projects/projects.json (env HYPR_PROJECTS_FILE or -f <file> overrides it), schema
#   {"items": [{"id","title","note"?,"status":"progress"|"built","created":ISO,"built_at"?:ISO}]}
# Every write is a read-modify-write under flock, IN PLACE (`cat tmp > file`, never mv: the shells watch the inode), and a file that
# is not valid JSON is never overwritten.  One copy of this script lives in each theme repo (identical); ~/.local/bin/hypr-projects
# links to one of them.  Migration: the first run copies ~/.config/overworld/projects.json (the old Overworld-only list) over when the
# shared file does not exist yet and keeps the old one as projects.json.bak.
set -uo pipefail

DEFAULT_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/hypr-projects/projects.json"
LEGACY_FILE="${HYPR_PROJECTS_LEGACY:-$HOME/.config/overworld/projects.json}"
FILE="${HYPR_PROJECTS_FILE:-$DEFAULT_FILE}"
if [[ "${1:-}" == "-f" || "${1:-}" == "--file" ]]; then FILE="${2:?hypr-projects: -f needs a file}"; shift 2; fi

say()  { printf '  %s\n' "$*"; }
warn() { printf 'hypr-projects: %s\n' "$*" >&2; }
die()  { warn "$*"; exit "${2:-1}"; }
command -v jq >/dev/null 2>&1 || die "jq is required"

# ------------------------------------------------------------------------------------------------ the rules (jq)
# --arg op id title note status now newid      --argjson delta at item
read -r -d '' JQ_PROG <<'JQ'
def inprogress: [.items[] | select(.status != "built")];
def built: [.items | to_entries[] | select(.value.status == "built")] | sort_by([.value.built_at // "", .key]) | reverse | map(.value);
def ordered: inprogress + built;
def swap($i; $j): .[$i] as $a | .[$j] as $b | .[$i] = $b | .[$j] = $a;
def mark($st): if $st == "built" then .status = "built" | .built_at = $now else .status = "progress" | del(.built_at) end;

(if type == "object" then . else {} end)
| .items = ((.items // []) | if type == "array" then map(select(type == "object" and (.id | type) == "string" and (.title | type) == "string")) else [] end)
| if $op == "add" then
    .items += [ { id: $newid, title: $title }
                + (if $note != "" then { note: $note } else {} end)
                + { status: (if $status == "built" then "built" else "progress" end), created: $now }
                + (if $status == "built" then { built_at: $now } else {} end) ]
  elif $op == "toggle" then
    .items |= map(if .id == $id then mark(if .status == "built" then "progress" else "built" end) else . end)
  elif $op == "set" then
    .items |= map(if .id == $id and (.status == "built") != ($status == "built") then mark($status) else . end)
  elif $op == "remove" then
    .items |= map(select(.id != $id))
  elif $op == "edit" then
    .items |= map(if .id == $id then (.title = $title | if $note == "" then del(.note) else .note = $note end) else . end)
  elif $op == "retitle" then
    .items |= map(if .id == $id then .title = $title else . end)
  elif $op == "move" then
    .items as $it | ($it | map(.id) | index($id)) as $i
    | if $i == null then .
      else ($it[$i].status == "built") as $b
        | [range(0; $it | length) | select(($it[.].status == "built") == $b)] as $same
        | ($same | index($i) + $delta) as $q
        | if $q < 0 or $q >= ($same | length) then . else .items |= swap($i; $same[$q]) end
      end
  elif $op == "clearbuilt" then
    .items |= map(select(.status != "built"))
  elif $op == "ordered" then ordered
  elif $op == "insert" then
    .items |= (if any(.[]; .id == $item.id) then . else .[0:$at] + [$item] + .[$at:] end)
  else error("unknown op " + $op) end
JQ

ID=""; TITLE=""; NOTE=""; STATUS=""; DELTA=0; AT=0; ITEM=null
NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
NEWID="$(printf '%x%04x' "$(date +%s)" $((RANDOM % 65536)))"
run_jq() {                      # run_jq <op> <file>
    jq "${JQ_FLAGS:--c}" --arg op "$1" --arg id "$ID" --arg title "$TITLE" --arg note "$NOTE" --arg status "$STATUS" --arg now "$NOW" \
       --arg newid "$NEWID" --argjson delta "$DELTA" --argjson at "$AT" --argjson item "$ITEM" "$JQ_PROG" "$2"
}

# ------------------------------------------------------------------------------------------------ migration
migrate() {
    [[ -e "$FILE" ]] && return 0
    [[ "$FILE" == "$DEFAULT_FILE" || -n "${HYPR_PROJECTS_LEGACY:-}" ]] || return 0
    [[ -s "$LEGACY_FILE" ]] || return 0
    jq -e 'type == "object" and (.items | type) == "array"' "$LEGACY_FILE" >/dev/null 2>&1 || return 0
    mkdir -p "$(dirname "$FILE")"
    (
        flock 9
        [[ -e "$FILE" ]] && exit 0                    # somebody else migrated while we waited
        cp "$LEGACY_FILE" "$FILE.tmp.$$" && mv "$FILE.tmp.$$" "$FILE"   # the new file does not exist yet: nobody watches an inode
        if cmp -s "$LEGACY_FILE" "$FILE"; then mv "$LEGACY_FILE" "$LEGACY_FILE.bak"; fi
    ) 9>>"$FILE.lock"
}

# ------------------------------------------------------------------------------------------------ reading
blank_file() { ! grep -q '[^[:space:]]' "$FILE" 2>/dev/null; }      # missing, empty or whitespace only
ordered_json() {                # the list in displayed order, as a JSON array; status 1 if the file is not valid JSON
    if blank_file; then echo '[]'; return 0; fi
    run_jq ordered "$FILE" 2>/dev/null || { warn "$FILE is not valid JSON"; return 1; }
}
tsv_rows() {                    # n<TAB>status<TAB>id<TAB>title<TAB>note
    local o; o="$(ordered_json)" || return 1
    jq -r 'def f: tostring | gsub("[\t\r\n]"; " "); to_entries[] | [(.key + 1), (.value.status // "progress"), .value.id, .value.title, (.value.note // "")] | map(f) | join("\t")' <<<"$o"
}
resolve() {                     # resolve <n|id|title-text> -> id; status 3 = nothing matches, 4 = several match
    local q="${1:-}" o res
    [[ -n "$q" ]] || die "which project? give its number or the start of its title (hypr-projects list)" 2
    if blank_file; then die "no projects yet" 3; fi
    o="$(ordered_json)" || return 1
    res="$(jq -r --arg q "$q" '
        ($q | ascii_downcase) as $l
        | (if ($q | test("^[0-9]+$")) and ($q | tonumber) >= 1 and ($q | tonumber) <= length then .[($q | tonumber) - 1].id
           else ([.[] | select(.id == $q)][0].id // null) end) as $direct
        | ([.[] | select(.title | ascii_downcase == $l)]) as $exact
        | if $direct != null then $direct
          elif ($exact | length) == 1 then $exact[0].id
          else ([.[] | select(.title | ascii_downcase | startswith($l))]) as $pre
            | (if ($pre | length) > 0 then $pre else [.[] | select(.title | ascii_downcase | contains($l))] end) as $m
            | if ($m | length) == 1 then $m[0].id elif ($m | length) == 0 then "!none" else "!many" end
          end' <<<"$o")"
    case "$res" in
        '') die "could not read $FILE" 1 ;;
        '!none') die "nothing matches '$q'" 3 ;;
        '!many') die "'$q' matches several projects: use more of the title, or the number from 'hypr-projects list'" 4 ;;
        *) echo "$res" ;;
    esac
}
title_of() { tsv_rows | awk -F'\t' -v id="$1" '$3 == id { print $4; exit }'; }

# ------------------------------------------------------------------------------------------------ writing
write_op() {                    # write_op <op> [args…]  — see `help raw`; prints the new id for add
    local op="$1"; shift
    case "$op" in
        add) TITLE="${1:-}"; NOTE="${2:-}"; [[ "${3:-}" == built ]] && STATUS=built
             [[ -n "${TITLE//[[:space:]]/}" ]] || die "empty title" 2 ;;
        toggle|remove) ID="${1:-}" ;;
        retitle) ID="${1:-}"; TITLE="${2:-}"; [[ -n "${TITLE//[[:space:]]/}" ]] || die "empty title" 2 ;;
        set) ID="${1:-}"; STATUS="${2:-}" ;;
        edit) ID="${1:-}"; TITLE="${2:-}"; NOTE="${3:-}"; [[ -n "${TITLE//[[:space:]]/}" ]] || die "empty title" 2 ;;
        move) ID="${1:-}"; DELTA="${2:-0}" ;;
        clearbuilt) ;;
        insert) ITEM="${1:-null}"; AT="${2:-0}" ;;
        *) die "unknown op '$op'" 2 ;;
    esac
    migrate
    mkdir -p "$(dirname "$FILE")"
    local tmp; tmp="$(mktemp)" || return 1
    (
        flock 9
        blank_file && printf '{"items":[]}\n' >"$FILE"
        JQ_FLAGS=-M run_jq "$op" "$FILE" >"$tmp" && [[ -s "$tmp" ]] || { warn "could not update $FILE (is it valid JSON?)"; exit 1; }
        cat "$tmp" >"$FILE"
    ) 9>>"$FILE.lock"
    local rc=$?
    rm -f "$tmp"
    (( rc == 0 )) || return $rc
    [[ "$op" == add ]] && echo "$NEWID"
    return 0
}

# ------------------------------------------------------------------------------------------------ verbs
cmd_list() {
    local json=0 a
    for a in "$@"; do case "$a" in --json|-j) json=1 ;; *) die "list: unknown option $a" 2 ;; esac; done
    migrate
    if (( json )); then
        local o; o="$(ordered_json)" || return 1
        jq '[to_entries[] | {n: (.key + 1)} + .value]' <<<"$o"; return 0
    fi
    local rows; rows="$(tsv_rows)" || return 1
    if [[ -z "$rows" ]]; then say "no projects yet — hypr-projects add \"My project\""; return 0; fi
    local n_prog n_built
    n_prog="$(awk -F'\t' '$2 != "built"' <<<"$rows" | wc -l)"; n_built="$(awk -F'\t' '$2 == "built"' <<<"$rows" | wc -l)"
    if (( n_prog > 0 )); then echo "In progress ($n_prog)"; awk -F'\t' '$2 != "built" { printf "  %2d. [ ] %s%s\n", $1, $4, ($5 != "" ? "   (" $5 ")" : "") }' <<<"$rows"; fi
    if (( n_built > 0 )); then echo "Built ($n_built)"; awk -F'\t' '$2 == "built" { printf "  %2d. [x] %s%s\n", $1, $4, ($5 != "" ? "   (" $5 ")" : "") }' <<<"$rows"; fi
}
cmd_add() {
    local title="" note="" st=progress
    while (( $# )); do
        case "$1" in
            --note|-n) [[ -n "${2:-}" ]] || die "add: --note needs a text" 2; note="$2"; shift ;;
            --built|--done) st=built ;;
            *) title="${title:+$title }$1" ;;
        esac
        shift
    done
    title="$(tr -s '[:space:]' ' ' <<<"$title" | sed 's/^ //; s/ $//')"
    [[ -n "$title" ]] || die "usage: hypr-projects add <title…> [--note <text>] [--built]" 2
    write_op add "$title" "$note" "$st" >/dev/null || return 1
    say "added: $title"
}
cmd_mark() {                    # cmd_mark done|undone|toggle|rm <query…>
    local verb="$1"; shift
    migrate
    local id t rc=0
    id="$(resolve "${*:-}")" || return $?
    t="$(title_of "$id")"
    case "$verb" in
        done)   write_op set "$id" built || return 1;    say "built: $t" ;;
        undone) write_op set "$id" progress || return 1; say "back in progress: $t" ;;
        toggle) write_op toggle "$id" || return 1;       say "toggled: $t" ;;
        rm)     write_op remove "$id" || return 1;       say "removed: $t" ;;
    esac
    return $rc
}
cmd_rename() {
    migrate
    local q="${1:-}"; shift || true
    local id; id="$(resolve "$q")" || return $?
    local title; title="$(tr -s '[:space:]' ' ' <<<"$*" | sed 's/^ //; s/ $//')"
    [[ -n "$title" ]] || die "usage: hypr-projects rename <n|title> <new title…>" 2
    write_op retitle "$id" "$title" || return 1
    say "renamed: $title"
}
cmd_clear() {
    local yes=0 a
    for a in "$@"; do case "$a" in -y|--yes) yes=1 ;; *) die "clear: unknown option $a (use --yes)" 2 ;; esac; done
    migrate
    local n; n="$(tsv_rows | awk -F'\t' '$2 == "built"' | wc -l)"
    (( n > 0 )) || { say "no built projects"; return 0; }
    if (( ! yes )); then
        [[ -t 0 ]] || die "clear: not a terminal; pass --yes to remove the $n built projects without asking"
        local ans; read -r -p "Remove all $n built projects? [y/N] " ans || ans=""
        [[ "$ans" =~ ^[yY]([eE][sS])?$ ]] || { echo "cancelled"; return 0; }
    fi
    write_op clearbuilt || return 1
    say "removed $n built projects"
}

# ------------------------------------------------------------------------------------------------ summary (notify-send)
cmd_summary() {
    migrate
    local rows; rows="$(tsv_rows)" || return 1
    local n_prog n_built body
    n_prog="$(awk -F'\t' '$2 != "built"' <<<"$rows" | grep -c .)"; n_built="$(awk -F'\t' '$2 == "built"' <<<"$rows" | grep -c .)"
    body="$(awk -F'\t' '$2 != "built" && c++ < 6 { print "☐ " $4 }' <<<"$rows")"
    (( n_prog > 6 )) && body+=$'\n'"… and $((n_prog - 6)) more"
    [[ -n "$rows" ]] || body="Nothing yet — hypr-projects add \"My project\""
    local head="Projects · $n_prog in progress · $n_built built"
    if [[ "${1:-}" == "--print" ]]; then printf '%s\n%s\n' "$head" "$body"; return 0; fi
    if command -v notify-send >/dev/null 2>&1; then notify-send -a Projects -i emblem-documents "$head" "$body"
    else printf '%s\n%s\n' "$head" "$body"; fi
}

# ------------------------------------------------------------------------------------------------ rofi menu
# The loop is plain functions so tests can drive it without a window: HYPR_PROJECTS_ROFI replaces the `rofi` command (it gets the
# same arguments, the rows on stdin, and answers like rofi: the chosen index with -format i, or the typed text; exit 1 = Esc).
ROFI="${HYPR_PROJECTS_ROFI:-rofi}"
# rofi_pick <prompt> <selected-row> <mesg>  < rows   → prints the index (stdout), status 1 on Esc
rofi_pick() {
    "$ROFI" -dmenu -i -no-custom -format i -p "$1" -selected-row "${2:-0}" -mesg "$3" -l 14
}
rofi_ask() {                    # rofi_ask <prompt> <mesg> → the typed text; status 1 on Esc
    "$ROFI" -dmenu -i -format s -p "$1" -mesg "$2" -l 0 </dev/null
}
menu_rows() {                   # menu_rows <tsv rows>: the main menu lines (one per row); row 0 is always "+ Add project…"
    local rows="$1"
    echo "+ Add project…"
    awk -F'\t' '{ printf "%s %s%s\n", ($2 == "built" ? "☑" : "☐"), $4, ($5 != "" ? "  —  " $5 : "") }' <<<"$rows"
    [[ -n "$rows" ]] && echo "✕ Remove…"
    return 0
}
menu_run() {
    local sel=0 out idx rows n
    while true; do
        local mesg="Enter toggles · Esc closes"
        rows="$(tsv_rows)" || return 1
        n="$(grep -c . <<<"$rows")"; [[ -z "$rows" ]] && n=0
        out="$(menu_rows "$rows" | rofi_pick "Projects" "$sel" "$mesg")" || return 0     # Esc
        [[ "$out" =~ ^[0-9]+$ ]] || return 0
        idx="$out"
        if (( idx == 0 )); then
            local title; title="$(rofi_ask "New project" "Type a title, Enter adds it · Esc cancels")" || { sel=0; continue; }
            title="$(tr -s '[:space:]' ' ' <<<"$title" | sed 's/^ //; s/ $//')"
            if [[ -n "$title" ]]; then
                local newid; newid="$(write_op add "$title" "" progress)"
                sel="$(tsv_rows | awk -F'\t' -v id="$newid" '$3 == id { print $1; exit }')"; sel="${sel:-0}"
            else sel=0; fi
        elif (( idx <= n )); then
            local id; id="$(awk -F'\t' -v n="$idx" '$1 == n { print $3 }' <<<"$rows")"
            write_op toggle "$id" >/dev/null; sel="$idx"
        else
            menu_remove; sel=0
        fi
    done
}
menu_remove() {                 # "✕ Remove…": pick one to delete, loops until Esc
    local rows out idx id
    while true; do
        rows="$(tsv_rows)" || return 1
        [[ -n "$rows" ]] || return 0
        out="$(awk -F'\t' '{ printf "✕ %s\n", $4 }' <<<"$rows" | rofi_pick "Remove" 0 "Enter removes the project for good · Esc goes back")" || return 0
        [[ "$out" =~ ^[0-9]+$ ]] || return 0
        id="$(awk -F'\t' -v n="$((out + 1))" '$1 == n { print $3 }' <<<"$rows")"
        [[ -n "$id" ]] && write_op remove "$id" >/dev/null
    done
}
theme_on() {                    # a theme shell owns the desktop (and has its own dialog on this key)
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
    [[ -e "$cfg/overworld/enabled" || -e "$cfg/apothecary/enabled" ]]
}
cmd_menu() {
    local stock=0 a
    for a in "$@"; do case "$a" in --if-stock) stock=1 ;; *) die "menu: unknown option $a" 2 ;; esac; done
    if (( stock )) && theme_on; then return 0; fi
    migrate
    if [[ -z "${HYPR_PROJECTS_ROFI:-}" ]] && ! command -v rofi >/dev/null 2>&1; then
        command -v notify-send >/dev/null 2>&1 && notify-send -a Projects "Projects" "rofi is not installed"
        die "rofi is not installed"
    fi
    # one menu at a time: the same key is bound in both themes' off.conf, and key repeat would stack windows
    local lock="${XDG_RUNTIME_DIR:-/tmp}/hypr-projects-menu.lock"
    exec 8>"$lock"
    flock -n 8 || return 0
    menu_run
}

# ------------------------------------------------------------------------------------------------ help
cmd_help() {
    case "${1:-}" in
    raw) cat <<'EOF'
hypr-projects [-f file] raw <op> …   (low level; what ProjectsService.qml and the theme CLIs call. Prints nothing unless noted)
  add <title> [note] [built]  → prints the new id      toggle <id>          set <id> built|progress
  remove <id>                 edit <id> <title> [note]  move <id> <+1|-1>    clearbuilt
  insert <json-item> <index>  (undo of a remove)
  list                        n<TAB>status<TAB>id<TAB>title<TAB>note, displayed order, no write
  resolve <n|id|title-text>   → the id; status 3 = nothing matches, 4 = several match
EOF
    ;;
    *) cat <<'EOF'
hypr-projects — the Projects to-do list shared by Overworld, Apothecary and the stock desktop

  hypr-projects [list] [--json]           numbered list: in progress first, then built (newest first)
  hypr-projects add <title…> [--note <text>] [--built]
  hypr-projects done <n|title>            tick it: built
  hypr-projects undone <n|title>          back to in progress
  hypr-projects toggle <n|title>
  hypr-projects rm <n|title>              remove it
  hypr-projects rename <n|title> <new title…>
  hypr-projects clear [--yes]             remove every built project
  hypr-projects menu                      rofi picker: Enter toggles a row, "+ Add project…" asks for a title, "✕ Remove…" deletes;
                                          loops until Esc.  SUPER+SHIFT+P on the stock desktop.  --if-stock: do nothing while a theme is on
  hypr-projects summary [--print]         desktop notification: "Projects · 3 in progress · 2 built" + the open ones
  hypr-projects path                      where the list lives
  hypr-projects help raw                  the low-level ops used by the shell widgets

<n|title> is the number from `list`, or the start of a title (any part of it if that is unique).
File: ~/.local/share/hypr-projects/projects.json (HYPR_PROJECTS_FILE or -f overrides).  Themes watch it: edits show up live.
Examples:
  hypr-projects add "Hyprland rice" --note "waybar part left"
  hypr-projects done 2
  hypr-projects rm todo
EOF
    ;;
    esac
}

verb="${1:-list}"; shift || true
case "$verb" in
    list|ls)               cmd_list "$@" ;;
    add)                   cmd_add "$@" ;;
    done|built|check)      cmd_mark done "$@" ;;
    undone|uncheck)        cmd_mark undone "$@" ;;
    toggle)                cmd_mark toggle "$@" ;;
    rm|remove|del|delete)  cmd_mark rm "$@" ;;
    rename|edit)           cmd_rename "$@" ;;
    clear)                 cmd_clear "$@" ;;
    menu)                  cmd_menu "$@" ;;
    summary)               cmd_summary "$@" ;;
    path)                  echo "$FILE" ;;
    migrate)               migrate ;;
    resolve)               migrate; resolve "${1:-}" ;;
    raw)
        op="${1:-}"; shift || true
        case "$op" in
            migrate) migrate ;;
            list) migrate; tsv_rows ;;
            resolve) migrate; resolve "${1:-}" ;;
            ordered) migrate; ordered_json ;;
            *) write_op "$op" "$@" ;;
        esac ;;
    help|-h|--help)        cmd_help "$@" ;;
    *)                     warn "unknown command: $verb"; cmd_help >&2; exit 2 ;;
esac
